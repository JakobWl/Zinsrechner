{
  "name": "zinsrechner",
  "version": "1.2.4",
  "description": "WiDev Zinsrechner.",
  "author": "Jakob Winkler",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "tsc && vite build",
    "build": "tauri build",
    "build:store": "tauri build --no-bundle && pwsh -NoProfile -File scripts/build-store-package.ps1",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:native": "node --test --test-concurrency=1 tests/native/*.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "validate:store": "pwsh -NoProfile -File scripts/validate-store-package.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "antd": "^5.26.6",
    "antd-style": "^3.7.1",
    "chart.js": "^4.5.1",
    "dayjs": "^1.11.13",
    "react-chartjs-2": "^5.3.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@tauri-apps/plugin-process": "^2",
    "jspdf": "^3",
    "jspdf-autotable": "^5"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "less": "^4.4.0",
    "prettier": "^3.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.3",
    "vite": "6.3.4",
    "vitest": "^3.2.4",
    "@tauri-apps/cli": "^2",
    "selenium-webdriver": "^4"
  }
}
